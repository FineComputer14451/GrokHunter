# Copy to ~/.grok/secrets.env and chmod 600
# Never commit the real file.
#
# SpaceXAI (xAI) — key + OpenAI-compatible API
#   console:  https://console.x.ai
#   base URL: https://api.x.ai/v1
#   default model: grok-4.5
#   docs: https://docs.x.ai

export XAI_API_KEY="xai-your-key-here"

# Optional: pin Aider / custom clients to the coding model
# export AIDER_MODEL="grok-4.5"
# export OPENAI_API_BASE="https://api.x.ai/v1"

# Optional overrides
# export GROK_NETHUNTER_FLAGS="--fullscreen"
# export GROK_STUDIO_DIR="${HOME}/Grok-Imagine-Cinematic-Studio"
