+# ---------- Overlay completeness ----------
+hdr "Overlay completeness"
+
+FULL_TREE=0
+if [[ -d "${GROKHUNTER_HOME}/bin" && -d "${GROKHUNTER_HOME}/skills" && -d "${GROKHUNTER_HOME}/agents" ]]; then
+  ok "Full overlay tree present (${GROKHUNTER_HOME})"
+  FULL_TREE=1
+else
+  warn "Full overlay tree missing (one-liner only?)"
+  warn "  Clone + install skills for agents / personas / menu:"
+  warn "  git clone https://github.com/FineComputer14451/GrokHunter.git ~/GrokHunter"
+  warn "  cd ~/GrokHunter && grokhunter skills install"
+  WARN=1
+fi
+
+# Count how many core skills are actually installed
+if declare -F _gh_count_core_installed >/dev/null 2>&1; then
+  CORE_INSTALLED="$(_gh_count_core_installed 2>/dev/null || echo 0)"
+  CORE_N="${#GH_CORE_SKILLS[@]}"
+  [[ "${CORE_N}" -gt 0 ]] || CORE_N=3
+  if [[ "${CORE_INSTALLED}" -ge "${CORE_N}" ]]; then
+    ok "Core skills installed (${CORE_INSTALLED}/${CORE_N})"
+  else
+    warn "Core skills incomplete (${CORE_INSTALLED}/${CORE_N}) — run: grokhunter skills install"
+    WARN=1
+  fi
+fi
+
