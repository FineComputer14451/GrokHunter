#!/usr/bin/env bash
# GrokHunter primary CLI — Kali NetHunter × Grok Build
set -euo pipefail

export PATH="${HOME}/.grok/bin:${HOME}/.local/bin:${PATH}"

# Resolve overlay root (clone → GROKHUNTER_HOME → ~/GrokHunter → cache stamp)
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_gh_cli_root() {
  local d stamp
  if [[ -f "${HERE}/../install.sh" ]]; then
    cd "${HERE}/.." && pwd
    return 0
  fi
  for d in "${GROKHUNTER_HOME:-}" "${HOME}/GrokHunter"; do
    [[ -n "${d}" ]] || continue
    case "${d}" in
      /dev/fd|/dev/fd/*|/proc/self/fd|/proc/self/fd/*) continue ;;
    esac
    if [[ -f "${d}/install.sh" ]]; then
      printf '%s\n' "${d}"
      return 0
    fi
  done
  stamp="${HOME}/.cache/grokhunter/OVERLAY_ROOT"
  if [[ -r "${stamp}" ]]; then
    d="$(tr -d '[:space:]' < "${stamp}" 2>/dev/null || true)"
    if [[ -n "${d}" && -f "${d}/install.sh" ]]; then
      printf '%s\n' "${d}"
      return 0
    fi
  fi
  if [[ -f "${HOME}/.cache/grokhunter/src/install.sh" ]]; then
    printf '%s\n' "${HOME}/.cache/grokhunter/src"
    return 0
  fi
  printf '%s\n' "${HERE}"
}
ROOT="$(_gh_cli_root)"
export GROKHUNTER_HOME="${GROKHUNTER_HOME:-$ROOT}"
case "${GROKHUNTER_HOME}" in
  /dev/fd|/dev/fd/*|/proc/self/fd|/proc/self/fd/*)
    export GROKHUNTER_HOME="${ROOT}" ;;
esac

# Discovery helpers (skills / agents / personas / roles)
# shellcheck disable=SC1091
if [[ -f "${GROKHUNTER_HOME}/lib/skills-discover.sh" ]]; then
  # shellcheck source=lib/skills-discover.sh
  source "${GROKHUNTER_HOME}/lib/skills-discover.sh"
fi
# shellcheck disable=SC1091
if [[ -f "${GROKHUNTER_HOME}/lib/agents-discover.sh" ]]; then
  # shellcheck source=lib/agents-discover.sh
  source "${GROKHUNTER_HOME}/lib/agents-discover.sh"
fi
# shellcheck disable=SC1091
if [[ -f "${GROKHUNTER_HOME}/lib/personas-discover.sh" ]]; then
  # shellcheck source=lib/personas-discover.sh
  source "${GROKHUNTER_HOME}/lib/personas-discover.sh"
fi
# shellcheck disable=SC1091
if [[ -f "${GROKHUNTER_HOME}/lib/roles-discover.sh" ]]; then
  # shellcheck source=lib/roles-discover.sh
  source "${GROKHUNTER_HOME}/lib/roles-discover.sh"
fi
# shellcheck disable=SC1091
if [[ -f "${GROKHUNTER_HOME}/lib/git-identity.sh" ]]; then
  # shellcheck source=lib/git-identity.sh
  source "${GROKHUNTER_HOME}/lib/git-identity.sh"
fi

# Prefer repo bin/ when not installed to PATH (doctor/dev clone)
export PATH="${GROKHUNTER_HOME}/bin:${PATH}"

# Version
if [[ -f "${GROKHUNTER_HOME}/VERSION" ]]; then
  VERSION="$(tr -d '[:space:]' < "${GROKHUNTER_HOME}/VERSION")"
else
  VERSION="${GROKHUNTER_VERSION:-1.0.9}"
fi

_count_installed() {
  # $1 = kind: agents|personas|roles
  local kind="$1" n=0 name
  case "${kind}" in
    agents)
      if declare -F _gh_list_agent_names >/dev/null 2>&1; then
        while IFS= read -r name; do
          [[ -n "${name}" ]] || continue
          [[ -f "${HOME}/.grok/agents/${name}.md" ]] && n=$((n + 1))
        done < <(_gh_list_agent_names "${GROKHUNTER_HOME}")
      fi
      ;;
    personas)
      if declare -F _gh_list_persona_names >/dev/null 2>&1; then
        while IFS= read -r name; do
          [[ -n "${name}" ]] || continue
          [[ -f "${HOME}/.grok/personas/${name}.toml" ]] && n=$((n + 1))
        done < <(_gh_list_persona_names "${GROKHUNTER_HOME}")
      fi
      ;;
    roles)
      if declare -F _gh_list_role_names >/dev/null 2>&1; then
        while IFS= read -r name; do
          [[ -n "${name}" ]] || continue
          [[ -f "${HOME}/.grok/roles/${name}.toml" ]] && n=$((n + 1))
        done < <(_gh_list_role_names "${GROKHUNTER_HOME}")
      fi
      ;;
  esac
  printf '%s\n' "${n}"
}

_resolve_grok_bin() {
  local grok_bin="${HOME}/.grok/bin/grok"
  if [[ -x "${grok_bin}" ]]; then
    printf '%s\n' "${grok_bin}"
    return 0
  fi
  if command -v grok >/dev/null 2>&1; then
    command -v grok
    return 0
  fi
  return 1
}

_grok_launcher() {
  local launcher="${HOME}/.local/bin/grok-nethunter"
  if [[ -x "${launcher}" ]]; then
    printf '%s\n' "${launcher}"
    return 0
  fi
  launcher="${GROKHUNTER_HOME}/bin/grok-nethunter"
  printf '%s\n' "${launcher}"
}

_v9_script() {
  local s="${GROKHUNTER_HOME}/scripts/install_v9_grok_models.sh"
  if [[ -f "${s}" ]]; then
    printf '%s\n' "${s}"
    return 0
  fi
  s="${HERE}/../scripts/install_v9_grok_models.sh"
  if [[ -f "${s}" ]]; then
    printf '%s\n' "${s}"
    return 0
  fi
  return 1
}

usage() {
  cat <<EOF
GrokHunter v${VERSION} — Kali NetHunter powered by Grok Build

Usage:
  grokhunter                  Interactive fullscreen TUI
  grokhunter status           Short status line (always exit 0)
  grokhunter doctor           Full health report
  grokhunter binds [cmd]      Proot binds (status|repair|optimize)
  grokhunter setup [opts]     One-shot lab sync (ensure + skills + optional models)
  grokhunter menu [install|remove]  Kali/XFCE Applications → GrokHunter submenu
  grokhunter ensure           Install/upgrade Grok Build binary
  grokhunter models [cmd]     V9 / 4.6 model pickers (install|status|force)
  grokhunter skills [cmd]     Install/status lab skills under ~/.grok/skills
  grokhunter agents [cmd]     List/status Coding Team agents
  grokhunter team [prompt]    Launch coding-team agent (TUI or -p headless)
  grokhunter scout [prompt]   Launch scout agent
  grokhunter review [prompt]  Launch review agent
  grokhunter fix [prompt]     Launch fix agent
  grokhunter desktop [prompt] Launch desktop (X11) agent
  grokhunter overlay [prompt] Launch overlay/install agent
  grokhunter ship [prompt]    Launch release/ship agent
  grokhunter docs [prompt]    Launch docs agent
  grokhunter modeler [prompt] Launch models/V9 agent (grok --agent models)
  grokhunter ci [prompt]      Launch CI agent
  grokhunter aider [prompt]   Launch aider-grok agent
  grokhunter session [prompt] Launch tmux / grok-resume agent
  grokhunter host [prompt]    Launch Termux-vs-Kali agent
  grokhunter mcp [prompt]     Launch MCP agent (CLI is grok mcp)
  grokhunter plugin [prompt]  Launch plugin agent (CLI is grok plugin)
  grokhunter flow [prompt]    Launch workflow agent
  grokhunter storage [prompt] Launch disk/cache agent
  grokhunter editor [prompt]  Launch nvim/micro agent
  grokhunter hook [prompt]    Launch Grok hooks agent
  grokhunter shell [prompt]   Launch profile/completions agent
  grokhunter github [prompt]  Launch git-identity agent (CLI is git-identity)
  grokhunter secrets [prompt] Launch secrets.env agent
  grokhunter toolchain [prompt] Launch apt/compiler agent
  grokhunter ai-smoke [prompt] SpaceXAI API smoke (scripts/spacexai_smoke.sh)
  grokhunter smoke [prompt]   Alias for ai-smoke
  grokhunter install [args]   Run / re-run installer (supports --overlay-only)
  grokhunter plan <prompt>    Plan mode (built-in plan agent)
  grokhunter -p <prompt>      Headless / one-shot
  grokhunter -- <grok args>   Pass-through to grok
  grokhunter git-identity     Show/set git user.name + email (GitHub attribution)
  grokhunter credits          Upstream attribution (jorexdeveloper · CREDITS.md)
  grokhunter help             This help
  grokhunter version          Print version

setup options:
  --force-grok     Reinstall Grok even if present
  --with-models    Also install V9 /model pickers
  --with-aider     Also run scripts/install_aider.sh
  --no-doctor      Skip doctor at the end
  --yes            Non-interactive (default for flags)

Skills:
  skills install   skills + agents + personas + roles + wrappers
  status skills-core=N/3  core trio only (grokhunter, pair-programming, aider-grok)

Exit codes:
  0  success (status always 0; doctor PASS / PASS-with-warnings)
  1  operational failure (doctor ISSUES; skills/models incomplete)
  2  usage error

Aliases (after profile install):
  ghn  → grok-nethunter
  ghd  → doctor
  ghsu → setup
  ght  → team
  ghp  → plan
  ghm  → models
  ghk  → skills
  ghai → ai-smoke
  ghh  → headless -p

Env:
  XAI_API_KEY                 API auth
  GROK_NETHUNTER_FLAGS        Extra default flags for launcher
  GROKHUNTER_HOME             Overlay root (default ~/GrokHunter)
  GROKHUNTER_MIN_GROK         Min binary version (default 1.0.5)
  GROKHUNTER_GROK_INSTALLER   auto|official|termux-native (ensure)
  GROKHUNTER_FORCE_GROK=1     Reinstall Grok even if present
  GROKHUNTER_SKIP_PROFILE=1   Skip NetHunter config.toml profile merge
  GROKHUNTER_REFRESH=1        Bypass module/engine cache on install
  GROKHUNTER_DISTRO_ENGINE_URL  Pin/fork of termux-distro.sh (install)
EOF
}

cmd_status() {
  local gver="missing"
  if command -v grok >/dev/null 2>&1; then
    gver=$(grok --version 2>/dev/null | head -1 || echo "unknown")
  fi
  local auth="no-key"
  if [[ -n "${XAI_API_KEY:-}" ]]; then
    auth="env-key"
  elif [[ -r "${HOME}/.grok/secrets.env" ]]; then
    auth="secrets.env"
  elif [[ -r "${HOME}/.grok/auth.json" ]]; then
    auth="auth.json"
  fi
  local x11="no"
  command -v nh-x11 >/dev/null 2>&1 && x11="yes"
  local session="default"
  if [[ -r "${HOME}/.config/grokhunter/x11-session" ]]; then
    session="$(tr -d '[:space:]' < "${HOME}/.config/grokhunter/x11-session")"
  fi
  local models="no"
  local cfg="${GROK_CONFIG:-${HOME}/.grok/config.toml}"
  local marker="# --- GrokHunter: v9 specialist models"
  local marker_legacy="# --- Grok Imagine Cinematic Studio: v9-4p5 specialist models"
  if [[ -f "${cfg}" ]] && { grep -qF "${marker}" "${cfg}" 2>/dev/null || grep -qF "${marker_legacy}" "${cfg}" 2>/dev/null; }; then
    models="yes"
  fi
  local skills core_n
  skills="$(_gh_count_core_installed 2>/dev/null || echo 0)"
  core_n="${#GH_CORE_SKILLS[@]}"
  [[ "${core_n}" -gt 0 ]] || core_n=3
  local wrappers="no"
  if command -v grokhunter >/dev/null 2>&1 || [[ -x "${HOME}/.local/bin/grokhunter" ]]; then
    wrappers="yes"
  fi
  local agents personas roles
  agents="$(_count_installed agents)"
  personas="$(_count_installed personas)"
  roles="$(_count_installed roles)"
  printf "GrokHunter %s | %s | auth=%s | x11=%s | models=%s | skills-core=%s/%s | agents=%s | personas=%s | roles=%s | wrappers=%s | session=%s | home=%s\n" \
    "$VERSION" "$gver" "$auth" "$x11" "$models" "$skills" "$core_n" \
    "$agents" "$personas" "$roles" "$wrappers" "$session" "$GROKHUNTER_HOME"
}

# One-shot: ensure Grok → skills/agents/personas/roles → optional models/aider → doctor
cmd_setup() {
  local force_grok=0 with_models=0 with_aider=0 no_doctor=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force-grok) force_grok=1; shift ;;
      --with-models) with_models=1; shift ;;
      --with-aider) with_aider=1; shift ;;
      --no-doctor) no_doctor=1; shift ;;
      --yes|-y) shift ;; # accepted for scripting symmetry
      -h|--help)
        cat <<'EOF'
Usage: grokhunter setup [options]

  One-shot lab sync for an existing clone / overlay:
    1. grokhunter ensure   (Grok Build ≥ 1.0.5 + NetHunter profile)
    2. grokhunter skills install
    3. optional: models install / Aider install
    4. git-identity set    (if still placeholder)
    5. grokhunter doctor   (unless --no-doctor)

Options:
  --force-grok     Reinstall Grok even if present
  --with-models    Install V9 /model pickers
  --with-aider     Run scripts/install_aider.sh
  --no-doctor      Skip doctor summary
  --yes            Non-interactive (default)
EOF
        return 0
        ;;
      *)
        echo "Unknown setup option: $1" >&2
        echo "Try: grokhunter setup --help" >&2
        return 2
        ;;
    esac
  done

  echo "=== GrokHunter setup (v${VERSION}) ==="
  echo "home: ${GROKHUNTER_HOME}"
  echo

  echo "→ [1/4] ensure Grok Build…"
  if [[ "${force_grok}" -eq 1 ]]; then
    cmd_ensure --force
  else
    cmd_ensure
  fi
  echo

  echo "→ [2/4] skills + agents + personas + roles…"
  cmd_skills_install
  # Ensure desktop session preference exists for nh-x11 / doctor
  if [[ -f "${GROKHUNTER_HOME}/lib/x11.sh" ]]; then
    # shellcheck disable=SC1091
    source "${GROKHUNTER_HOME}/lib/x11.sh" 2>/dev/null || true
    if declare -F ensure_x11_session >/dev/null 2>&1; then
      ensure_x11_session "" 0 2>/dev/null || true
      if [[ -r "${HOME}/.config/grokhunter/x11-session" ]]; then
        echo "  x11-session: $(tr -d '[:space:]' < "${HOME}/.config/grokhunter/x11-session")"
      fi
    fi
  fi
  echo

  if [[ "${with_models}" -eq 1 ]]; then
    echo "→ [3/4] V9 model pickers…"
    local script
    if script="$(_v9_script)"; then
      bash "${script}" || echo "  WARN: models install reported issues" >&2
    else
      echo "  WARN: install_v9_grok_models.sh missing" >&2
    fi
    echo
  else
    echo "→ [3/4] models skipped (pass --with-models)"
    echo
  fi

  if [[ "${with_aider}" -eq 1 ]]; then
    echo "→ Aider…"
    local aider="${GROKHUNTER_HOME}/scripts/install_aider.sh"
    if [[ -f "${aider}" ]]; then
      bash "${aider}" || echo "  WARN: Aider install reported issues" >&2
    else
      echo "  WARN: scripts/install_aider.sh missing" >&2
    fi
    echo
  fi

  echo "→ git identity…"
  if declare -F _gh_git_identity_is_placeholder >/dev/null 2>&1; then
    if _gh_git_identity_is_placeholder "$(_gh_git_identity_name)" "$(_gh_git_identity_email)"; then
      cmd_git_identity set || echo "  WARN: placeholder git identity — grokhunter git-identity set --name NAME --email EMAIL" >&2
    else
      cmd_git_identity show || true
    fi
  else
    echo "  WARN: lib/git-identity.sh not loaded" >&2
  fi
  echo

  if [[ "${no_doctor}" -eq 0 ]]; then
    echo "→ [4/4] doctor…"
    local doc="${HOME}/.local/bin/grokhunter-doctor"
    [[ -x "$doc" ]] || doc="${GROKHUNTER_HOME}/bin/grokhunter-doctor"
    if [[ -f "${doc}" ]]; then
      bash "${doc}" || true
    else
      echo "  doctor not found"
    fi
  else
    echo "→ doctor skipped (--no-doctor)"
  fi

  echo
  echo "=== setup complete ==="
  cmd_status
}

cmd_agents_status() {
  local name n=0
  echo "agents dir: ${HOME}/.grok/agents"
  echo "repo:       ${GROKHUNTER_HOME}/agents"
  if ! declare -F _gh_list_agent_names >/dev/null 2>&1; then
    echo "  error: agents-discover not loaded" >&2
    return 1
  fi
  while IFS= read -r name; do
    [[ -n "${name}" ]] || continue
    if [[ -f "${HOME}/.grok/agents/${name}.md" ]]; then
      echo "  installed: ${name}"
      n=$((n + 1))
    else
      echo "  repo-only: ${name}  (run: grokhunter skills install)"
    fi
  done < <(_gh_list_agent_names "${GROKHUNTER_HOME}")
  echo "installed: ${n}"
  echo "launch:    grokhunter team | scout | review | fix | desktop | overlay | ship | docs | modeler | ci | aider | session | host | mcp | plugin | flow | storage | editor | hook | shell"
  echo "tui:       /config-agents"
  [[ "${n}" -gt 0 ]]
}

cmd_agents() {
  local sub="${1:-status}"
  shift || true
  case "${sub}" in
    help|-h|--help)
      cat <<'EOF'
Usage: grokhunter agents [status|list|help]

  status|list   Show installed vs repo Coding Team agents (default)
  help          This help

Install agents:  grokhunter skills install
Launch:          grokhunter team | scout | review | fix | desktop | overlay | ship | docs | modeler | ci | aider | session | host | mcp | plugin | flow | storage | editor | hook | shell
EOF
      return 0
      ;;
    status|list|--status)
      cmd_agents_status
      return $?
      ;;
    *)
      echo "Unknown agents subcommand: ${sub}" >&2
      echo "Usage: grokhunter agents [status|list|help]" >&2
      return 2
      ;;
  esac
}

# Launch a named Grok Build agent. With args: headless -p; without: interactive TUI.
cmd_agent_launch() {
  local agent="$1"
  shift || true
  local grok_bin prompt
  if ! grok_bin="$(_resolve_grok_bin)"; then
    echo "grok not found — run: grokhunter ensure   (or: grokhunter setup)" >&2
    return 127
  fi
  # Ensure agent file exists (best-effort install hint)
  if [[ ! -f "${HOME}/.grok/agents/${agent}.md" ]] \
     && [[ -f "${GROKHUNTER_HOME}/agents/${agent}.md" ]]; then
    echo "WARN: agent '${agent}' not in ~/.grok/agents — run: grokhunter skills install" >&2
  fi

  if [[ $# -eq 0 ]]; then
    # Interactive: fullscreen via grok-nethunter defaults when possible
    if [[ -x "${HOME}/.local/bin/grok-nethunter" ]] || [[ -x "${GROKHUNTER_HOME}/bin/grok-nethunter" ]]; then
      exec "$(_grok_launcher)" --agent "${agent}"
    fi
    exec "${grok_bin}" --agent "${agent}"
  fi

  prompt="$*"
  case "${agent}" in
    benjamin)
      exec "${grok_bin}" --agent benjamin --permission-mode plan -p "${prompt}"
      ;;
    scout|review)
      exec "${grok_bin}" --agent "${agent}" --permission-mode plan -p "${prompt}"
      ;;
    *)
      exec "${grok_bin}" --agent "${agent}" -p "${prompt}"
      ;;
  esac
}

cmd_ensure() {
  local min="${GROKHUNTER_MIN_GROK:-1.0.5}"
  if [[ "${1:-}" == "--force" ]]; then
    export GROKHUNTER_FORCE_GROK=1
  fi

  # ensure_grok.sh enforces min version, prefers `grok update`, applies 1.0.5 profile
  local ensure="${GROKHUNTER_HOME}/scripts/ensure_grok.sh"
  if [[ ! -f "$ensure" ]]; then
    ensure="${HERE}/../scripts/ensure_grok.sh"
  fi
  if [[ -f "$ensure" ]]; then
    echo "Ensuring Grok Build ≥ ${min} (1.0.5+ profile)…"
    bash "$ensure"
  else
    echo "scripts/ensure_grok.sh not found — falling back to official installer…"
    curl -fsSL "${GROKHUNTER_GROK_OFFICIAL_URL:-https://x.ai/cli/install.sh}" | bash
    local profile="${GROKHUNTER_HOME}/scripts/install_grok_profile.sh"
    [[ -f "${profile}" ]] && bash "${profile}" || true
  fi
  export PATH="${HOME}/.grok/bin:${HOME}/.local/bin:${PATH}"
  grok --version || true
}

cmd_install() {
  local installer="${GROKHUNTER_HOME}/install.sh"
  if [[ ! -f "$installer" ]]; then
    echo "install.sh not found at ${installer}" >&2
    echo "Clone the repo or re-run the one-liner first." >&2
    exit 1
  fi
  exec bash "$installer" "$@"
}

cmd_menu() {
  local sub="${1:-install}"
  local script="${GROKHUNTER_HOME}/scripts/install_kali_menu.sh"
  if [[ ! -f "${script}" ]]; then
    echo "scripts/install_kali_menu.sh not found under ${GROKHUNTER_HOME}" >&2
    return 1
  fi
  case "${sub}" in
    help|-h|--help)
      cat <<'EOF'
Usage: grokhunter menu [install|remove|help]

  install   Add Applications → GrokHunter submenu (default)
  remove    Remove GrokHunter .desktop menu entries
EOF
      return 0
      ;;
    install|add|"")
      bash "${script}"
      return $?
      ;;
    remove|uninstall|--remove)
      bash "${script}" --remove
      return $?
      ;;
    *)
      echo "Unknown menu subcommand: ${sub}" >&2
      return 2
      ;;
  esac
}

cmd_ai_smoke() {
  local script="${GROKHUNTER_HOME}/scripts/spacexai_smoke.sh"
  if [[ ! -f "${script}" ]]; then
    script="${HERE}/../scripts/spacexai_smoke.sh"
  fi
  if [[ ! -f "${script}" ]]; then
    echo "scripts/spacexai_smoke.sh not found under ${GROKHUNTER_HOME}" >&2
    echo "  Clone the repo or re-run install from a full tree." >&2
    exit 1
  fi
  exec bash "${script}" "$@"
}

cmd_skills_status() {
  local name dest count=0
  local skills_root="${GROKHUNTER_HOME}/skills"
  echo "skills dir: ${HOME}/.grok/skills"
  echo "repo:       ${skills_root}"
  if [[ ! -d "${skills_root}" ]]; then
    echo "  missing:   (no repo skills/ tree)"
    return 1
  fi
  if ! declare -F _gh_list_skill_names >/dev/null 2>&1; then
    echo "  error: skill discovery not loaded (lib/skills-discover.sh)" >&2
    return 1
  fi
  while IFS= read -r name; do
    [[ -n "${name}" ]] || continue
    dest="${HOME}/.grok/skills/${name}/SKILL.md"
    if [[ -f "${dest}" ]]; then
      echo "  installed: ${name}"
      count=$((count + 1))
    else
      echo "  repo-only: ${name}  (run: grokhunter skills install)"
    fi
  done < <(_gh_list_skill_names "${GROKHUNTER_HOME}")
  echo "installed: ${count}"
  # Success if all core skills present (not full inventory)
  local core core_n
  core="$(_gh_count_core_installed)"
  core_n="${#GH_CORE_SKILLS[@]}"
  [[ "${core}" -ge "${core_n}" ]]
}

cmd_skills_install() {
  local root="${GROKHUNTER_HOME}"
  if [[ ! -f "${root}/lib/grok.sh" ]]; then
    echo "lib/grok.sh not found under ${root}" >&2
    exit 1
  fi
  # shellcheck disable=SC1091
  SCRIPT_DIR="${root}"
  export SCRIPT_DIR
  # shellcheck source=/dev/null
  source "${root}/lib/grok.sh"
  msg() { shift || true; printf '[grokhunter skills] %s\n' "$*"; }
  cursor() { :; }
  install_cli_bins
  cmd_skills_status || true
}

cmd_skills() {
  local sub="${1:-status}"
  shift || true
  case "${sub}" in
    help|-h|--help)
      cat <<'EOF'
Usage: grokhunter skills [status|install]

  status    Show which skills are under ~/.grok/skills (default)
  install   Copy repo skills + agents + personas + roles; refresh wrappers
            (~/.grok/{skills,agents,personas,roles})
EOF
      return 0
      ;;
    status|--status)
      cmd_skills_status
      return $?
      ;;
    install)
      cmd_skills_install
      return $?
      ;;
    *)
      echo "Unknown skills subcommand: ${sub}" >&2
      echo "Usage: grokhunter skills [status|install]" >&2
      exit 2
      ;;
  esac
}

cmd_plan() {
  local prompt="$*"
  if [[ -z "$prompt" ]]; then
    echo "Usage: grokhunter plan <prompt>" >&2
    exit 2
  fi
  export PATH="${HOME}/.grok/bin:${HOME}/.local/bin:${PATH}"
  local grok_bin
  if ! grok_bin="$(_resolve_grok_bin)"; then
    echo "grok not found — run: grokhunter ensure" >&2
    exit 127
  fi
  exec "${grok_bin}" --agent plan --permission-mode plan -p "${prompt}"
}

cmd_credits() {
  local f="${GROKHUNTER_HOME}/CREDITS.md"
  cat <<'EOF'
GrokHunter Rootless — credits
=============================
Not affiliated with the projects below — we build on them with thanks.

1) jorexdeveloper — install engine (primary)
   https://github.com/jorexdeveloper
   termux-nethunter  https://github.com/jorexdeveloper/termux-nethunter
   termux-distro     https://github.com/jorexdeveloper/termux-distro
   GPL-3.0 · NetHunter rootless install + termux-distro.sh engine

2) Termux team — host platform
   https://github.com/termux  ·  https://termux.dev
   Termux app, packages, proot host
   Termux:X11  https://github.com/termux/termux-x11

3) Kali Linux / Offensive Security — NetHunter rootfs
   https://www.kali.org/  ·  https://www.offsec.com/
   Official NetHunter rootfs images (kali.download/nethunter-images)
   Coding-lab use of Kali packages — not an OffSec product

4) xAI — Grok Build & models
   https://x.ai  ·  https://x.ai/cli  ·  https://docs.x.ai
   Grok Build agent (1.0.5+), Grok models / API
   Auth: SuperGrok / X Premium+ or XAI_API_KEY

Also: Aider (aider.chat) · uv (astral.sh) when using --with-aider

GrokHunter is an overlay (CLI, skills, agents, desktop helpers).
It does NOT re-claim authorship of the above.

Thank you — please support those projects directly.
EOF
  echo
  if [[ -f "${f}" ]]; then
    echo "Full statement: ${f}"
    echo "Online: https://github.com/FineComputer14451/GrokHunter/blob/main/CREDITS.md"
  else
    echo "CREDITS.md not found under ${GROKHUNTER_HOME}"
    echo "Online: https://github.com/FineComputer14451/GrokHunter/blob/main/CREDITS.md"
  fi
}

cmd_models_status() {
  local cfg="${GROK_CONFIG:-${HOME}/.grok/config.toml}"
  local marker="# --- GrokHunter: v9 specialist models"
  local marker_legacy="# --- Grok Imagine Cinematic Studio: v9-4p5 specialist models"
  echo "config: ${cfg}"
  if [[ ! -f "${cfg}" ]]; then
    echo "status: missing (no config.toml — run grok once, then: grokhunter models install)"
    return 1
  fi
  if { grep -qF "${marker}" "${cfg}" 2>/dev/null || grep -qF "${marker_legacy}" "${cfg}" 2>/dev/null; } \
    && grep -qE '^\[model\.(chat-expert|multi|auto|"chat-expert")' "${cfg}" 2>/dev/null; then
    echo "status: installed (V9 / 4.6 picker surface present)"
    echo "  switch: /model chat-expert · multi · auto · grok-v9"
    return 0
  fi
  echo "status: incomplete or missing V9 pickers"
  echo "  fix: grokhunter models install"
  return 1
}

cmd_models() {
  local sub="${1:-status}"
  shift || true
  local script
  case "${sub}" in
    help|-h|--help)
      cat <<'EOF'
Usage: grokhunter models [install|status|force]

  install   Write V9 / 4.6 model pickers into ~/.grok/config.toml
  status    Report whether pickers are present (default)
  force     Re-install pickers even if already complete

Script: scripts/install_v9_grok_models.sh
EOF
      return 0
      ;;
    status|--status)
      cmd_models_status
      return $?
      ;;
    install)
      if ! script="$(_v9_script)"; then
        echo "scripts/install_v9_grok_models.sh not found under ${GROKHUNTER_HOME}" >&2
        exit 1
      fi
      exec bash "${script}" "$@"
      ;;
    force|--force)
      if ! script="$(_v9_script)"; then
        echo "scripts/install_v9_grok_models.sh not found under ${GROKHUNTER_HOME}" >&2
        exit 1
      fi
      exec bash "${script}" --force "$@"
      ;;
    *)
      echo "Unknown models subcommand: ${sub}" >&2
      echo "Usage: grokhunter models [install|status|force]" >&2
      exit 2
      ;;
  esac
}


cmd_git_identity() {
  local sub="${1:-show}"
  shift || true
  if ! declare -F _gh_git_identity_is_placeholder >/dev/null 2>&1; then
    if [[ -f "${GROKHUNTER_HOME}/lib/git-identity.sh" ]]; then
      # shellcheck disable=SC1091
      source "${GROKHUNTER_HOME}/lib/git-identity.sh"
    else
      echo "lib/git-identity.sh missing under ${GROKHUNTER_HOME}" >&2
      return 1
    fi
  fi
  if ! command -v git >/dev/null 2>&1; then
    echo "git not found — sudo apt install -y git" >&2
    return 1
  fi
  case "${sub}" in
    help|-h|--help)
      cat <<'EOF'
Usage: grokhunter git-identity [show|set|help]

  show   Print git user.name / user.email (default)
  set    Write identity so GitHub can attach commits to your account

set sources (first match wins):
  --name NAME --email EMAIL
  GROKHUNTER_GIT_NAME / GROKHUNTER_GIT_EMAIL
  gh api user
  GH_TOKEN / GITHUB_TOKEN → api.github.com/user
  origin github.com/OWNER → public /users/OWNER

  --local    Write repo-local config instead of --global

Kali/Termux often default to root <root@localhost.localdomain>
(or an empty ident that becomes kali@localhost). GitHub cannot map
those addresses and shows invalid-email-address.
Use the GitHub noreply from https://github.com/settings/emails :
  git config --global user.email 'ID+LOGIN@users.noreply.github.com'
EOF
      return 0
      ;;
    show|status|"")
      local name email
      name="$(_gh_git_identity_name)"
      email="$(_gh_git_identity_email)"
      if [[ -z "${name}" && -z "${email}" ]]; then
        echo "git identity: unset"
      else
        echo "git identity: ${name:-unset} <${email:-unset}>"
      fi
      if _gh_git_identity_is_placeholder "${name}" "${email}"; then
        echo "status: placeholder (GitHub will show invalid-email-address)"
        echo "fix:    grokhunter git-identity set"
        return 1
      fi
      echo "status: ok"
      return 0
      ;;
    set|--set)
      local name="${GROKHUNTER_GIT_NAME:-}" email="${GROKHUNTER_GIT_EMAIL:-}" scope="global" pair
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --name) name="${2:-}"; shift 2 ;;
          --email) email="${2:-}"; shift 2 ;;
          --local) scope="local"; shift ;;
          --global) scope="global"; shift ;;
          -h|--help)
            cmd_git_identity help
            return 0
            ;;
          *)
            echo "Unknown git-identity set option: $1" >&2
            echo "Try: grokhunter git-identity help" >&2
            return 2
            ;;
        esac
      done
      if [[ -z "${name}" || -z "${email}" ]]; then
        if pair="$(_gh_git_identity_resolve)"; then
          [[ -n "${name}" ]] || name="$(printf '%s' "${pair}" | awk -F'\t' '{print $1}')"
          [[ -n "${email}" ]] || email="$(printf '%s' "${pair}" | awk -F'\t' '{print $2}')"
        fi
      fi
      if [[ -z "${name}" || -z "${email}" ]]; then
        echo "Could not resolve git identity (no gh, token, or GitHub origin)." >&2
        echo "Pass --name and --email, set GROKHUNTER_GIT_NAME / GROKHUNTER_GIT_EMAIL," >&2
        echo "authenticate GitHub CLI (gh auth login), or export GH_TOKEN." >&2
        return 1
      fi
      if [[ "${scope}" == "local" ]] && ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "--local requires a git working tree" >&2
        return 1
      fi
      _gh_git_identity_set "${name}" "${email}" "${scope}"
      echo "git identity (${scope}): ${name} <${email}>"
      return 0
      ;;
    *)
      echo "Unknown git-identity subcommand: ${sub}" >&2
      echo "Usage: grokhunter git-identity [show|set|help]" >&2
      return 2
      ;;
  esac
}

main() {
  local sub="${1:-}"
  case "$sub" in
    "")
      exec "$(_grok_launcher)" "$@"
      ;;
    help|-h|--help)
      usage
      ;;
    version|-V|--version)
      echo "GrokHunter ${VERSION}"
      ;;
    git-identity|git_identity|identity)
      shift || true
      cmd_git_identity "$@"
      ;;
    credits|credit|attribution|thanks)
      cmd_credits
      ;;
    status)
      cmd_status
      ;;
    doctor)
      local doc="${GROKHUNTER_HOME}/bin/grokhunter-doctor"
      [[ -f "$doc" ]] || doc="${HOME}/.local/bin/grokhunter-doctor"
      exec bash "$doc"
      ;;
    binds|proot-binds)
      shift || true
      if [[ ! -f "${GROKHUNTER_HOME}/lib/x11.sh" ]]; then
        echo "lib/x11.sh not found under ${GROKHUNTER_HOME}" >&2
        return 1
      fi
      # shellcheck source=lib/x11.sh
      source "${GROKHUNTER_HOME}/lib/x11.sh"
      cmd_binds "$@"
      ;;
    setup|sync|boot)
      shift || true
      cmd_setup "$@"
      ;;
    menu|kali-menu|desktop-menu)
      shift || true
      cmd_menu "${1:-install}"
      ;;
    ensure)
      shift || true
      cmd_ensure "${1:-}"
      ;;
    models)
      shift || true
      cmd_models "$@"
      ;;
    skills)
      shift || true
      cmd_skills "$@"
      ;;
    agents)
      shift || true
      cmd_agents "$@"
      ;;
    team|coding-team)
      shift || true
      cmd_agent_launch coding-team "$@"
      ;;
    scout|benjamin|lucas|harper|review|fix|desktop|overlay|ship|docs|ci|aider|session|host|mcp|plugin|flow|storage|editor|hook|shell|github|secrets|toolchain)
      shift || true
      cmd_agent_launch "${sub}" "$@"
      ;;
    modeler)
      shift || true
      cmd_agent_launch models "$@"
      ;;
    ai-smoke|smoke)
      shift || true
      cmd_ai_smoke "$@"
      ;;
    install)
      shift || true
      cmd_install "$@"
      ;;
    plan)
      shift
      cmd_plan "$@"
      ;;
    -p|--prompt)
      shift
      exec "$(_grok_launcher)" -p "$@"
      ;;
    --)
      shift
      exec "$(_grok_launcher)" "$@"
      ;;
    *)
      exec "$(_grok_launcher)" "$@"
      ;;
  esac
}

main "$@"
