#!/usr/bin/env bash
# GrokHunter primary CLI — Kali NetHunter × Grok Build
set -euo pipefail

export PATH="${HOME}/.grok/bin:${HOME}/.local/bin:${PATH}"

# Resolve overlay root
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${HERE}/../install.sh" ]]; then
  ROOT="$(cd "${HERE}/.." && pwd)"
elif [[ -d "${HOME}/GrokHunter" ]]; then
  ROOT="${HOME}/GrokHunter"
else
  ROOT="${HERE}"
fi
export GROKHUNTER_HOME="${GROKHUNTER_HOME:-$ROOT}"

# Prefer repo bin/ when not installed to PATH (doctor/dev clone)
export PATH="${GROKHUNTER_HOME}/bin:${PATH}"

# Version
if [[ -f "${GROKHUNTER_HOME}/VERSION" ]]; then
  VERSION="$(tr -d '[:space:]' < "${GROKHUNTER_HOME}/VERSION")"
else
  VERSION="${GROKHUNTER_VERSION:-1.0.2}"
fi

_grok_launcher() {
  local launcher="${HOME}/.local/bin/grok-nethunter"
  if [[ -x "${launcher}" ]]; then
    printf '%s\n' "${launcher}"
    return 0
  fi
  launcher="${GROKHUNTER_HOME}/bin/grok-nethunter"
  printf '%s\n' "${launcher}"
}

_v9_script() {
  local s="${GROKHUNTER_HOME}/scripts/install_v9_grok_models.sh"
  if [[ -f "${s}" ]]; then
    printf '%s\n' "${s}"
    return 0
  fi
  s="${HERE}/../scripts/install_v9_grok_models.sh"
  if [[ -f "${s}" ]]; then
    printf '%s\n' "${s}"
    return 0
  fi
  return 1
}

usage() {
  cat <<EOF
GrokHunter v${VERSION} — Kali NetHunter powered by Grok Build

Usage:
  grokhunter                  Interactive fullscreen TUI
  grokhunter status           Short status line
  grokhunter doctor           Full health report
  grokhunter ensure           Install/upgrade Grok Build binary
  grokhunter models [cmd]     V9 / 4.5 model pickers (install|status|force)
  grokhunter skills [cmd]     Install/status lab skills under ~/.grok/skills
  grokhunter ai-smoke [prompt] SpaceXAI API smoke (scripts/spacexai_smoke.sh)
  grokhunter smoke [prompt]   Alias for ai-smoke
  grokhunter install [args]   Run / re-run installer (supports --overlay-only)
  grokhunter plan <prompt>    Plan mode
  grokhunter -p <prompt>      Headless / one-shot
  grokhunter -- <grok args>   Pass-through to grok
  grokhunter help             This help
  grokhunter version          Print version

Aliases (after profile install):
  gh   → grokhunter
  ghn  → grok-nethunter
  ghd  → doctor
  ghp  → plan
  ghm  → models
  ghk  → skills
  ghai → ai-smoke
  ghh  → headless -p

Env:
  XAI_API_KEY                 API auth
  GROK_NETHUNTER_FLAGS        Extra default flags for launcher
  GROKHUNTER_HOME             Overlay root (default ~/GrokHunter)
  GROKHUNTER_MIN_GROK         Min binary version (default 0.2.93)
  GROKHUNTER_GROK_INSTALLER   auto|official|termux-native (ensure)
  GROKHUNTER_FORCE_GROK=1     Reinstall Grok even if present
  GROKHUNTER_REFRESH=1        Bypass module/engine cache on install
  GROKHUNTER_DISTRO_ENGINE_URL  Pin/fork of termux-distro.sh (install)
EOF
}

cmd_status() {
  local gver="missing"
  if command -v grok >/dev/null 2>&1; then
    gver=$(grok --version 2>/dev/null | head -1 || echo "unknown")
  fi
  local auth="no-key"
  if [[ -n "${XAI_API_KEY:-}" ]]; then
    auth="env-key"
  elif [[ -r "${HOME}/.grok/secrets.env" ]]; then
    auth="secrets.env"
  elif [[ -r "${HOME}/.grok/auth.json" ]]; then
    auth="auth.json"
  fi
  local x11="no"
  command -v nh-x11 >/dev/null 2>&1 && x11="yes"
  local session="default"
  if [[ -r "${HOME}/.config/grokhunter/x11-session" ]]; then
    session="$(tr -d '[:space:]' < "${HOME}/.config/grokhunter/x11-session")"
  fi
  local models="no"
  local cfg="${GROK_CONFIG:-${HOME}/.grok/config.toml}"
  local marker="# --- Grok Imagine Cinematic Studio: v9-4p5 specialist models"
  if [[ -f "${cfg}" ]] && grep -qF "${marker}" "${cfg}" 2>/dev/null; then
    models="yes"
  fi
  local skills="0"
  local s
  for s in grokhunter pair-programming aider-grok; do
    if [[ -f "${HOME}/.grok/skills/${s}/SKILL.md" ]]; then
      skills=$((skills + 1))
    fi
  done
  local wrappers="no"
  if command -v grokhunter >/dev/null 2>&1 || [[ -x "${HOME}/.local/bin/grokhunter" ]]; then
    wrappers="yes"
  fi
  printf "GrokHunter %s | %s | auth=%s | x11=%s | models=%s | skills=%s/3 | wrappers=%s | session=%s | home=%s\n" \
    "$VERSION" "$gver" "$auth" "$x11" "$models" "$skills" "$wrappers" "$session" "$GROKHUNTER_HOME"
}

cmd_ensure() {
  local min="${GROKHUNTER_MIN_GROK:-0.2.93}"
  local force=0
  if [[ "${1:-}" == "--force" ]]; then
    force=1
    export GROKHUNTER_FORCE_GROK=1
  fi

  if command -v grok >/dev/null 2>&1 && [[ "${force}" -eq 0 ]]; then
    local gver
    gver=$(grok --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)
    if [[ -n "$gver" ]] && printf '%s\n%s\n' "$min" "$gver" | sort -V | head -1 | grep -qx "$min"; then
      echo "Grok Build ${gver} already ≥ ${min}"
      echo "  (reinstall: grokhunter ensure --force)"
      return 0
    fi
  fi

  local ensure="${GROKHUNTER_HOME}/scripts/ensure_grok.sh"
  if [[ ! -f "$ensure" ]]; then
    ensure="${HERE}/../scripts/ensure_grok.sh"
  fi
  if [[ -f "$ensure" ]]; then
    echo "Ensuring Grok Build via shared installer…"
    bash "$ensure"
  else
    echo "scripts/ensure_grok.sh not found — falling back to official installer…"
    curl -fsSL "${GROKHUNTER_GROK_OFFICIAL_URL:-https://x.ai/cli/install.sh}" | bash
  fi
  export PATH="${HOME}/.grok/bin:${HOME}/.local/bin:${PATH}"
  grok --version || true
}

cmd_install() {
  local installer="${GROKHUNTER_HOME}/install.sh"
  if [[ ! -f "$installer" ]]; then
    echo "install.sh not found at ${installer}" >&2
    echo "Clone the repo or re-run the one-liner first." >&2
    exit 1
  fi
  exec bash "$installer" "$@"
}

cmd_ai_smoke() {
  local script="${GROKHUNTER_HOME}/scripts/spacexai_smoke.sh"
  if [[ ! -f "${script}" ]]; then
    script="${HERE}/../scripts/spacexai_smoke.sh"
  fi
  if [[ ! -f "${script}" ]]; then
    echo "scripts/spacexai_smoke.sh not found under ${GROKHUNTER_HOME}" >&2
    echo "  Clone the repo or re-run install from a full tree." >&2
    exit 1
  fi
  exec bash "${script}" "$@"
}

cmd_skills_status() {
  local s dest count=0
  echo "skills dir: ${HOME}/.grok/skills"
  echo "repo:       ${GROKHUNTER_HOME}/skills"
  for s in grokhunter pair-programming aider-grok nethunter-recon; do
    dest="${HOME}/.grok/skills/${s}/SKILL.md"
    if [[ -f "${dest}" ]]; then
      echo "  installed: ${s}"
      count=$((count + 1))
    elif [[ -f "${GROKHUNTER_HOME}/skills/${s}/SKILL.md" ]]; then
      echo "  repo-only: ${s}  (run: grokhunter skills install)"
    else
      echo "  missing:   ${s}"
    fi
  done
  echo "installed: ${count}"
  [[ ${count} -ge 3 ]]
}

cmd_skills_install() {
  local root="${GROKHUNTER_HOME}"
  if [[ ! -f "${root}/lib/grok.sh" ]]; then
    echo "lib/grok.sh not found under ${root}" >&2
    exit 1
  fi
  # shellcheck disable=SC1091
  SCRIPT_DIR="${root}"
  export SCRIPT_DIR
  # shellcheck source=/dev/null
  source "${root}/lib/grok.sh"
  msg() { shift || true; printf '[grokhunter skills] %s\n' "$*"; }
  cursor() { :; }
  install_cli_bins
  cmd_skills_status || true
}

cmd_skills() {
  local sub="${1:-status}"
  shift || true
  case "${sub}" in
    help|-h|--help)
      cat <<'EOF'
Usage: grokhunter skills [status|install]

  status    Show which skills are under ~/.grok/skills (default)
  install   Copy repo skills + refresh ~/.local/bin wrappers
EOF
      return 0
      ;;
    status|--status)
      cmd_skills_status
      return $?
      ;;
    install)
      cmd_skills_install
      return $?
      ;;
    *)
      echo "Unknown skills subcommand: ${sub}" >&2
      echo "Usage: grokhunter skills [status|install]" >&2
      exit 2
      ;;
  esac
}

cmd_plan() {
  local prompt="$*"
  if [[ -z "$prompt" ]]; then
    echo "Usage: grokhunter plan <prompt>" >&2
    exit 2
  fi
  exec "$(_grok_launcher)" -p "Enter plan mode first. Task: ${prompt}"
}

cmd_models_status() {
  local cfg="${GROK_CONFIG:-${HOME}/.grok/config.toml}"
  local marker="# --- Grok Imagine Cinematic Studio: v9-4p5 specialist models"
  echo "config: ${cfg}"
  if [[ ! -f "${cfg}" ]]; then
    echo "status: missing (no config.toml — run grok once, then: grokhunter models install)"
    return 1
  fi
  if grep -qF "${marker}" "${cfg}" 2>/dev/null \
    && grep -qE '^\[model\.(chat-expert|multi|auto|"chat-expert")' "${cfg}" 2>/dev/null; then
    echo "status: installed (V9 / 4.5 picker surface present)"
    echo "  switch: /model chat-expert · multi · auto · grok-v9"
    return 0
  fi
  echo "status: incomplete or missing V9 pickers"
  echo "  fix: grokhunter models install"
  return 1
}

cmd_models() {
  local sub="${1:-status}"
  shift || true
  local script
  case "${sub}" in
    help|-h|--help)
      cat <<'EOF'
Usage: grokhunter models [install|status|force]

  install   Write V9 / 4.5 model pickers into ~/.grok/config.toml
  status    Report whether pickers are present (default)
  force     Re-install pickers even if already complete

Script: scripts/install_v9_grok_models.sh
EOF
      return 0
      ;;
    status|--status)
      cmd_models_status
      return $?
      ;;
    install)
      if ! script="$(_v9_script)"; then
        echo "scripts/install_v9_grok_models.sh not found under ${GROKHUNTER_HOME}" >&2
        exit 1
      fi
      exec bash "${script}" "$@"
      ;;
    force|--force)
      if ! script="$(_v9_script)"; then
        echo "scripts/install_v9_grok_models.sh not found under ${GROKHUNTER_HOME}" >&2
        exit 1
      fi
      exec bash "${script}" --force "$@"
      ;;
    *)
      echo "Unknown models subcommand: ${sub}" >&2
      echo "Usage: grokhunter models [install|status|force]" >&2
      exit 2
      ;;
  esac
}

main() {
  local sub="${1:-}"
  case "$sub" in
    "")
      exec "$(_grok_launcher)" "$@"
      ;;
    help|-h|--help)
      usage
      ;;
    version|-V|--version)
      echo "GrokHunter ${VERSION}"
      ;;
    status)
      cmd_status
      ;;
    doctor)
      local doc="${HOME}/.local/bin/grokhunter-doctor"
      [[ -x "$doc" ]] || doc="${GROKHUNTER_HOME}/bin/grokhunter-doctor"
      exec bash "$doc"
      ;;
    ensure)
      shift || true
      cmd_ensure "${1:-}"
      ;;
    models)
      shift || true
      cmd_models "$@"
      ;;
    skills)
      shift || true
      cmd_skills "$@"
      ;;
    ai-smoke|smoke)
      shift || true
      cmd_ai_smoke "$@"
      ;;
    install)
      shift || true
      cmd_install "$@"
      ;;
    plan)
      shift
      cmd_plan "$@"
      ;;
    -p|--prompt)
      shift
      exec "$(_grok_launcher)" -p "$@"
      ;;
    --)
      shift
      exec "$(_grok_launcher)" "$@"
      ;;
    *)
      exec "$(_grok_launcher)" "$@"
      ;;
  esac
}

main "$@"
