#!/usr/bin/env bash
# GrokHunter primary CLI — Kali NetHunter × Grok Build
set -euo pipefail

export PATH="${HOME}/.grok/bin:${HOME}/.local/bin:${PATH}"

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${HERE}/../install.sh" ]]; then
  ROOT="$(cd "${HERE}/.." && pwd)"
elif [[ -d "${HOME}/GrokHunter" ]]; then
  ROOT="${HOME}/GrokHunter"
else
  ROOT="${HERE}"
fi
export GROKHUNTER_HOME="${GROKHUNTER_HOME:-$ROOT}"

if [[ -f "${GROKHUNTER_HOME}/VERSION" ]]; then
  VERSION="$(tr -d '[:space:]' < "${GROKHUNTER_HOME}/VERSION")"
else
  VERSION="${GROKHUNTER_VERSION:-1.0.0}"
fi

_resolve_launcher() {
  local launcher="${HOME}/.local/bin/grok-nethunter"
  [[ -x "$launcher" ]] || launcher="${GROKHUNTER_HOME}/bin/grok-nethunter"
  if [[ ! -x "$launcher" ]]; then
    echo "grok-nethunter not found (set GROKHUNTER_HOME or install bin/)" >&2
    exit 1
  fi
  printf '%s\n' "$launcher"
}

usage() {
  cat <<EOF
GrokHunter v${VERSION} — Kali NetHunter powered by Grok Build

Usage:
  grokhunter                  Interactive fullscreen TUI
  grokhunter status           Short status line
  grokhunter doctor           Full health report
  grokhunter ensure           Install/upgrade Grok Build binary
  grokhunter models [status]  V9 / 4.5 model pickers (config.toml)
  grokhunter install [args]   Run / re-run the NetHunter installer
  grokhunter plan <prompt>    Plan mode
  grokhunter -p <prompt>      Headless / one-shot
  grokhunter -- <grok args>   Pass-through to grok
  grokhunter help             This help
  grokhunter version          Print version

Env:
  XAI_API_KEY              API auth
  GROKHUNTER_HOME          Overlay root (default ~/GrokHunter)
  GROKHUNTER_MIN_GROK      Min binary version (default 0.2.93)
EOF
}

cmd_status() {
  local gver="missing"
  if command -v grok >/dev/null 2>&1; then
    gver=$(grok --version 2>/dev/null | head -1 || echo "unknown")
  fi
  local auth="no-key"
  if [[ -n "${XAI_API_KEY:-}" ]]; then
    auth="env-key"
  elif [[ -r "${HOME}/.grok/secrets.env" ]]; then
    auth="secrets.env"
  elif [[ -r "${HOME}/.grok/auth.json" ]]; then
    auth="auth.json"
  fi
  local x11="no"
  command -v nh-x11 >/dev/null 2>&1 && x11="yes"
  local v9="no"
  if [[ -f "${HOME}/.grok/config.toml" ]] && grep -q "v9-4p5 specialist models" "${HOME}/.grok/config.toml" 2>/dev/null; then
    v9="yes"
  fi
  printf "GrokHunter %s | %s | auth=%s | x11=%s | v9=%s | home=%s\n" \
    "$VERSION" "$gver" "$auth" "$x11" "$v9" "$GROKHUNTER_HOME"
}

cmd_ensure() {
  local min="${GROKHUNTER_MIN_GROK:-0.2.93}"
  if command -v grok >/dev/null 2>&1; then
    local gver
    gver=$(grok --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)
    if [[ -n "$gver" ]] && printf '%s\n%s\n' "$min" "$gver" | sort -V | head -1 | grep -qx "$min"; then
      if [[ "${1:-}" != "--force" ]]; then
        echo "Grok Build ${gver} already ≥ ${min}"
        return 0
      fi
    fi
  fi
  echo "Ensuring Grok Build via official installer…"
  curl -fsSL --connect-timeout 20 --max-time 180 --retry 2 https://x.ai/cli/install.sh | bash
  export PATH="${HOME}/.grok/bin:${HOME}/.local/bin:${PATH}"
  command -v grok >/dev/null 2>&1 && grok --version || echo "grok still not on PATH — restart shell" >&2
}

cmd_install() {
  local installer="${GROKHUNTER_HOME}/install.sh"
  if [[ ! -f "$installer" ]]; then
    echo "install.sh not found at ${installer}" >&2
    exit 1
  fi
  exec bash "$installer" "$@"
}

cmd_models() {
  local script="${GROKHUNTER_HOME}/scripts/install_v9_grok_models.sh"
  if [[ ! -f "$script" ]]; then
    echo "Missing ${script}" >&2
    echo "Clone GrokHunter or set GROKHUNTER_HOME." >&2
    exit 1
  fi
  case "${1:-}" in
    --force|-f) bash "$script" --force ;;
    ""|install) bash "$script" ;;
    status)
      local cfg="${HOME}/.grok/config.toml"
      if [[ -f "$cfg" ]] && grep -q "v9-4p5 specialist models" "$cfg" 2>/dev/null; then
        echo "V9 model pickers: installed in $cfg"
      else
        echo "V9 model pickers: not installed"
        echo "  Run: grokhunter models install"
      fi
      ;;
    *)
      echo "Usage: grokhunter models [install|status|--force]" >&2
      exit 2
      ;;
  esac
}

cmd_plan() {
  local prompt="$*"
  if [[ -z "$prompt" ]]; then
    echo "Usage: grokhunter plan <prompt>" >&2
    exit 2
  fi
  local launcher
  launcher="$(_resolve_launcher)"
  exec "$launcher" -p "Enter plan mode first. Task: ${prompt}"
}

main() {
  local sub="${1:-}"
  case "$sub" in
    "")
      local launcher
      launcher="$(_resolve_launcher)"
      exec "$launcher" "$@"
      ;;
    help|-h|--help) usage ;;
    version|-V|--version) echo "GrokHunter ${VERSION}" ;;
    status) cmd_status ;;
    doctor)
      local doc="${HOME}/.local/bin/grokhunter-doctor"
      [[ -x "$doc" ]] || doc="${GROKHUNTER_HOME}/bin/grokhunter-doctor"
      if [[ ! -x "$doc" ]]; then
        echo "grokhunter-doctor not found" >&2
        exit 1
      fi
      exec "$doc"
      ;;
    ensure)
      shift || true
      cmd_ensure "${1:-}"
      ;;
    models)
      shift || true
      cmd_models "${1:-}"
      ;;
    install)
      shift || true
      cmd_install "$@"
      ;;
    plan)
      shift
      cmd_plan "$@"
      ;;
    -p|--prompt)
      shift
      local launcher
      launcher="$(_resolve_launcher)"
      exec "$launcher" -p "$@"
      ;;
    --)
      shift
      local launcher
      launcher="$(_resolve_launcher)"
      exec "$launcher" "$@"
      ;;
    *)
      local launcher
      launcher="$(_resolve_launcher)"
      exec "$launcher" "$@"
      ;;
  esac
}

main "$@"
