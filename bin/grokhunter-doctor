#!/usr/bin/env bash
# GrokHunter Rootless — health report (coding lab)
set -euo pipefail

export PATH="${HOME}/.grok/bin:${HOME}/.local/bin:${PATH}"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[1;36m'
NC=$'\033[0m'

ok()   { printf "  ${GREEN}✓${NC} %s\n" "$*"; }
warn() { printf "  ${YELLOW}!${NC} %s\n" "$*"; }
bad()  { printf "  ${RED}✗${NC} %s\n" "$*"; }
hdr()  { printf "\n${CYAN}%s${NC}\n" "$*"; }

FAIL=0
WARN=0

hdr "GrokHunter Doctor (Rootless · coding lab)"
printf "  Host: %s | Arch: %s | Kernel: %s\n" \
  "$(hostname 2>/dev/null || echo '?')" "$(uname -m)" "$(uname -r)"

hdr "Environment"
ROOTLESS="unknown"
if [[ -n "${PREFIX:-}" && "$PREFIX" == *"com.termux"* ]]; then
  ok "Termux PREFIX detected"; ROOTLESS="termux-host"
elif [[ -d /data/data/com.termux ]]; then
  ok "Termux host paths present"; ROOTLESS="termux-host"
fi
if [[ -r /etc/os-release ]]; then
  # shellcheck disable=SC1091
  . /etc/os-release
  if [[ "${ID:-}" == "kali" ]]; then
    ok "Kali ${VERSION:-?} (${VERSION_CODENAME:-rolling})"
    if [[ "$ROOTLESS" == "termux-host" ]] || [[ -d /data/data/com.termux ]]; then
      ok "Rootless NetHunter-style layout (Kali + Termux)"; ROOTLESS="rootless-nethunter"
    fi
  else
    warn "Not Kali (ID=${ID:-unknown}) — lab still usable"; WARN=1
  fi
else
  bad "No /etc/os-release"; FAIL=1
fi
if command -v proot >/dev/null 2>&1 || [[ -n "${PROOT_TMPDIR:-}" ]]; then
  ok "proot signals present (rootless)"
fi
if command -v nethunter >/dev/null 2>&1 || command -v nh >/dev/null 2>&1; then
  ok "nethunter/nh launcher on PATH"
else
  warn "nethunter launcher not on PATH"; WARN=1
fi

hdr "Grok Build (pair programmer)"
MIN_VER="${GROKHUNTER_MIN_GROK:-0.2.93}"
if command -v grok >/dev/null 2>&1; then
  GVER_LINE=$(grok --version 2>/dev/null | head -1 || true)
  ok "Found: ${GVER_LINE:-grok} @ $(command -v grok)"
else
  bad "grok not on PATH — run: grokhunter ensure or install.sh --with-grok"; FAIL=1
fi

hdr "GrokHunter CLI"
for b in grokhunter grokhunter-doctor; do
  if command -v "$b" >/dev/null 2>&1; then ok "$b → $(command -v "$b")"
  else bad "$b missing from PATH"; FAIL=1; fi
done

hdr "Desktop (Termux:X11)"
if command -v nh-x11 >/dev/null 2>&1; then ok "nh-x11 helper present"
else warn "nh-x11 missing — optional: install.sh --with-x11"; WARN=1; fi

hdr "Authentication"
if [[ -n "${XAI_API_KEY:-}" ]]; then ok "XAI_API_KEY set in environment"
elif [[ -r "${HOME}/.grok/secrets.env" ]] && grep -q 'XAI_API_KEY=' "${HOME}/.grok/secrets.env" 2>/dev/null; then
  ok "XAI_API_KEY in ~/.grok/secrets.env"
else
  warn "No API key — export XAI_API_KEY or run grok once to login"; WARN=1
fi

hdr "V9 model pickers (optional)"
CFG="${HOME}/.grok/config.toml"
V9_MARK="# --- Grok Imagine Cinematic Studio: v9-4p5 specialist models"
if [[ -f "$CFG" ]] && grep -qF "$V9_MARK" "$CFG" 2>/dev/null; then
  ok "V9 specialist marker present in config.toml"
  ok "Install/refresh: grokhunter models install  (or --force)"
elif [[ -f "$CFG" ]]; then
  warn "No V9 model pickers — run: grokhunter models install"
  WARN=1
else
  warn "No config.toml — install V9 pickers after first grok launch"
  WARN=1
fi

hdr "Coding toolchain"
for cmd in git python3; do
  if command -v "$cmd" >/dev/null 2>&1; then ok "$cmd → $(command -v "$cmd")"
  else warn "$cmd missing"; WARN=1; fi
done

hdr "Optional pair tools"
if command -v aider >/dev/null 2>&1 || [[ -x "${HOME}/venv-aider/bin/aider" ]]; then
  ok "aider available"
else
  warn "Aider not installed — see docs/EDITORS.md"
fi

hdr "Config"
if [[ -f "${HOME}/.grok/config.toml" ]]; then ok "~/.grok/config.toml exists"
else warn "No config.toml yet"; WARN=1; fi

printf "\n"
if [[ "$FAIL" -eq 0 && "$WARN" -eq 0 ]]; then
  printf "${GREEN}Doctor: PASS${NC} — coding lab ready\n"; exit 0
elif [[ "$FAIL" -eq 0 ]]; then
  printf "${YELLOW}Doctor: PASS with warnings${NC}\n"; exit 0
else
  printf "${RED}Doctor: ISSUES FOUND${NC}\n"; exit 1
fi
