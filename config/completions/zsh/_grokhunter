#compdef grokhunter

# GrokHunter zsh completion
# Install: bash scripts/install-completions.sh
# Then in ~/.zshrc: autoload -Uz compinit && compinit

_grokhunter() {
  local -a commands
  commands=(
    'status:Short status line (auth/x11/skills/agents)'
    'doctor:Full health report'
    'binds:Proot binds (status|repair|optimize)'
    'proot-binds:Alias for binds'
    'setup:One-shot lab sync (ensure + skills + optional models)'
    'sync:Alias for setup'
    'boot:Alias for setup'
    'ensure:Install or upgrade Grok Build binary'
    'models:grok-4.6 profile / clean legacy V9 pickers'
    'skills:Install/status lab skills (~/.grok/skills)'
    'agents:List Coding Team agents'
    'team:Launch coding-team agent'
    'scout:Launch scout agent'
    'review:Launch review agent'
    'fix:Launch fix agent'
    'desktop:Launch desktop/X11 agent'
    'overlay:Launch overlay/install agent'
    'ship:Launch release/ship agent'
    'docs:Launch docs agent'
    'modeler:Launch models agent (grok-4.6 profile)'
    'ci:Launch CI agent'
    'aider:Launch aider-grok agent'
    'session:Launch tmux / grok-resume agent'
    'host:Launch Termux-vs-Kali agent'
    'mcp:Launch MCP agent (grok mcp is the CLI)'
    'plugin:Launch plugin agent (grok plugin is the CLI)'
    'flow:Launch workflow agent'
    'storage:Launch disk/cache agent'
    'editor:Launch nvim/micro agent'
    'hook:Launch Grok hooks agent'
    'shell:Launch profile/completions agent'
    'github:Launch git-identity agent (CLI is git-identity)'
    'secrets:Launch secrets.env agent'
    'toolchain:Launch apt/compiler agent'
    'tls:Launch TLS/CA agent'
    'net:Launch HTTPS/DNS agent'
    'tookie:Launch Tookie-OSINT agent'
    'benjamin:Launch benjamin architect agent'
    'lucas:Launch lucas builder agent'
    'harper:Launch harper reliability agent'
    'ai-smoke:SpaceXAI API smoke test'
    'smoke:Alias for ai-smoke'
    'install:Run or re-run rootless installer'
    'plan:Plan a coding task'
    'menu:Kali/XFCE Applications → GrokHunter submenu'
    'git-identity:Show or set git user.name / user.email'
    'credits:Upstream attribution (jorexdeveloper)'
    'help:Show help'
    'version:Print version'
  )

  local -a model_cmds
  model_cmds=(
    'status:Show grok-4.6 default / legacy V9 leftovers'
    'clean:Remove legacy V9 /model pickers'
    'install:Alias for clean (pickers retired)'
    'force:Alias for clean'
    'help:Models help'
  )

  local -a skills_cmds
  skills_cmds=(
    'install:Copy skills + agents + personas + roles + wrappers'
    'status:Show installed vs repo-only skills'
    'help:Skills help'
  )

  local -a agents_cmds
  agents_cmds=(
    'status:Show installed agents'
    'list:Alias for status'
    'help:Agents help'
  )

  local -a identity_cmds
  identity_cmds=(
    'show:Print git user.name / user.email'
    'set:Write git identity from gh / token / origin / flags'
    'help:Identity help'
  )

  local -a binds_cmds
  binds_cmds=(
    'status:Show desired vs applied nethunter/nh binds'
    'show:Alias for status'
    'repair:Force re-apply optimized binds'
    'optimize:Apply binds if missing or stale'
    'help:Binds help'
  )

  local -a setup_opts
  setup_opts=(
    '--force-grok[Reinstall Grok]'
    '--with-models[Clean legacy V9 pickers]'
    '--with-aider[Install Aider]'
    '--no-doctor[Skip doctor]'
    '--yes[Non-interactive]'
    '--help[Show help]'
  )

  local -a install_opts
  install_opts=(
    '--full[Full installation]'
    '--mini[Mini installation]'
    '--nano[Nano installation]'
    '--de[Desktop environment]:desktop:(xfce mate lxde kde gnome i3 e17)'
    '--browser[Browser]:browser:(chromium firefox both)'
    '--no-de[Skip desktop]'
    '--with-grok[Install Grok Build]'
    '--no-grok[Skip Grok Build]'
    '--with-x11[Install Termux:X11]'
    '--no-x11[Skip Termux:X11]'
    '--with-aider[Install Aider]'
    '--no-aider[Skip Aider]'
    '--with-v9-models[Deprecated no-op (V9 pickers removed)]'
    '--no-v9-models[Deprecated no-op (V9 pickers removed)]'
    '--with-completions[Install shell completions]'
    '--no-completions[Skip shell completions]'
    '--overlay-only[Optional overlays only; no rootfs download]'
    '--help[Show help]'
  )

  _arguments -C \
    '1:command:->cmd' \
    '*::arg:->args'

  case $state in
    cmd)
      _describe -t commands 'grokhunter command' commands
      _arguments \
        '-p[Headless prompt]:prompt:' \
        '--prompt[Headless prompt]:prompt:' \
        '--[Pass-through to grok]'
      ;;
    args)
      case $words[1] in
        models)
          _describe -t model_cmds 'models' model_cmds
          ;;
        skills)
          _describe -t skills_cmds 'skills' skills_cmds
          ;;
        agents)
          _describe -t agents_cmds 'agents' agents_cmds
          ;;
        git-identity)
          _describe -t identity_cmds 'git-identity' identity_cmds
          ;;
        binds|proot-binds)
          _describe -t binds_cmds 'binds' binds_cmds
          ;;
        setup|sync|boot)
          _values 'setup options' $setup_opts
          ;;
        install)
          _arguments $install_opts
          ;;
        ensure)
          _arguments '--force[Force reinstall even if version OK]'
          ;;
        plan|ai-smoke|smoke)
          _message 'prompt text'
          ;;
        -p|--prompt)
          _message 'prompt text'
          ;;
      esac
      ;;
  esac
}

_grokhunter "$@"
