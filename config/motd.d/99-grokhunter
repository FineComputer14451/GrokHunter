#!/bin/sh
# GrokHunter dynamic MOTD fragment (optional install into /etc/update-motd.d/)
printf '\n'
printf '  \033[1;36mGrokHunter\033[0m  ·  Kali NetHunter × Grok Build\n'
if command -v grok >/dev/null 2>&1; then
  ver=$(grok --version 2>/dev/null | head -1)
  printf '  Agent: %s\n' "$ver"
else
  printf '  Agent: grok not on PATH — run: bash ~/GrokHunter/install.sh\n'
fi
printf '  Launch: \033[1mgrokhunter\033[0m  ·  Health: \033[1mgrokhunter doctor\033[0m  ·  Credits: \033[1mgrokhunter credits\033[0m\n'
printf '  Thanks: jorexdeveloper · Termux · Kali/OffSec · xAI  (see CREDITS.md)\n'
printf '\n'
